<Window x:Class="SimpleVideoPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleVideoPlayer"
        xmlns:views="clr-namespace:SimpleVideoPlayer.Views"
        xmlns:vm="clr-namespace:SimpleVideoPlayer.ViewModels"
        xmlns:converters="clr-namespace:SimpleVideoPlayer.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}"
        WindowState="Maximized"
        WindowStyle="None"
        Background="{StaticResource PrimaryBackground}"
        KeyDown="Window_KeyDown"
        Focusable="True"
        Cursor="None">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:PathToImageConverter x:Key="PathToImage"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <DataTemplate DataType="{x:Type vm:FolderBrowserViewModel}">
            <views:FolderBrowserView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoPlayerViewModel}">
            <views:VideoPlayerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <ContentControl Content="{Binding CurrentView}"/>

        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                Panel.ZIndex="100">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="加载中..."
                           Style="{StaticResource LargeTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource MediumTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>