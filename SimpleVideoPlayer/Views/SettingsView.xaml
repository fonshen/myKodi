<UserControl x:Class="SimpleVideoPlayer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="{StaticResource PrimaryBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackground}" Padding="30,20">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙️" FontSize="40" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="设置"
                           Style="{StaticResource LargeTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="50,30">
            <StackPanel>
                <TextBlock Text="视频文件夹"
                           Style="{StaticResource MediumTextBlockStyle}"
                           Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding VideoRootFolder, Mode=TwoWay}"
                             Style="{StaticResource SettingsTextBoxStyle}"
                             IsReadOnly="True"/>
                    <Button Grid.Column="1"
                            Content="浏览..."
                            Style="{StaticResource LargeButtonStyle}"
                            Command="{Binding BrowseFolderCommand}"
                            FontSize="20"
                            Padding="25,15"
                            Margin="15,10,0,0"/>
                </Grid>

                <TextBlock Text="自动生成缩略图"
                           Style="{StaticResource MediumTextBlockStyle}"
                           Margin="0,40,0,10"/>
                <CheckBox IsChecked="{Binding AutoGenerateThumbnails}"
                          Content="启用"
                          Foreground="White"
                          FontSize="24"
                          Margin="0,10,0,0"/>

                <TextBlock Text="缩略图位置（秒）"
                           Style="{StaticResource MediumTextBlockStyle}"
                           Margin="0,40,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding ThumbnailPosition}"
                             Minimum="1"
                             Maximum="60"
                             Width="400"
                             Style="{StaticResource SettingsSliderStyle}"/>
                    <TextBlock Text="{Binding ThumbnailPosition, StringFormat={}{0}秒}"
                               Style="{StaticResource MediumTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>

                <TextBlock Text="快进/快退秒数"
                           Style="{StaticResource MediumTextBlockStyle}"
                           Margin="0,40,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Slider Value="{Binding FastForwardSeconds}"
                             Minimum="5"
                             Maximum="120"
                             Width="400"
                             Style="{StaticResource SettingsSliderStyle}"/>
                    <TextBlock Text="{Binding FastForwardSeconds, StringFormat={}{0}秒}"
                               Style="{StaticResource MediumTextBlockStyle}"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SecondaryBackground}" Padding="30,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="取消"
                        Style="{StaticResource LargeButtonStyle}"
                        Command="{Binding CancelCommand}"
                        FontSize="24"
                        Padding="30,15"
                        Margin="0,0,20,0"/>

                <Button Grid.Column="2"
                        Content="保存"
                        Style="{StaticResource LargeButtonStyle}"
                        Command="{Binding SaveSettingsCommand}"
                        FontSize="24"
                        Padding="30,15"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>