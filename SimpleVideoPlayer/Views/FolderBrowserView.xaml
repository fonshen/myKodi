<UserControl x:Class="SimpleVideoPlayer.Views.FolderBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SimpleVideoPlayer.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="{StaticResource PrimaryBackground}"
             Focusable="True"
             Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converters:PathToImageConverter x:Key="PathToImage"/>
        <converters:ItemTypeToIconConverter x:Key="ItemTypeToIcon"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibility"/>
        <converters:IndexConverter x:Key="IndexConverter"/>
        <converters:IndexEqualsConverter x:Key="IndexEqualsConverter"/>
        <converters:IndexEqualsAndFlagConverter x:Key="IndexEqualsAndFlagConverter"/>
        
        <Style x:Key="CategoryButtonStyle" TargetType="Button" BasedOn="{StaticResource LargeButtonStyle}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="25,15"/>
            <Setter Property="Margin" Value="8,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <!-- 选中样式：紫色背景 -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IndexEqualsConverter}">
                            <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}" Converter="{StaticResource IndexConverter}"/>
                            <Binding Path="DataContext.SelectedCategoryIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#9955dd"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="24"/>
                </DataTrigger>
                
                <!-- 焦点样式：绿色发光边框（非常醒目） -->
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource IndexEqualsAndFlagConverter}">
                            <Binding RelativeSource="{RelativeSource AncestorType=ContentPresenter}" Converter="{StaticResource IndexConverter}"/>
                            <Binding Path="DataContext.FocusedCategoryIndex" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                            <Binding Path="DataContext.IsFocusOnCategories" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="#00ff88"/>
                    <Setter Property="BorderThickness" Value="10"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#00ff88" BlurRadius="30" ShadowDepth="0" Opacity="1"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackground}" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ItemsControl x:Name="CategoryItemsControl"
                              Grid.Column="0"
                              ItemsSource="{Binding Categories}"
                              Focusable="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Margin="0,0,15,0"
                                    Padding="20,12"
                                    FontSize="20"
                                    Style="{StaticResource CategoryButtonStyle}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource IndexConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Content="⚙️"
                        Style="{StaticResource LargeButtonStyle}"
                        Command="{Binding OpenSettingsCommand}"
                        FontSize="28"
                        Padding="20,15"
                        PreviewKeyDown="SettingsButton_PreviewKeyDown"/>
            </Grid>
        </Border>

        <ListBox x:Name="VideoListBox"
                 Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedIndex="{Binding SelectedIndex}"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource CardListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 Focusable="True"
                 SelectionChanged="VideoListBox_SelectionChanged"
                 PreviewKeyDown="VideoListBox_PreviewKeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" Margin="20" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"
                            Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Margin="12"
                            Style="{StaticResource CardButtonStyle}"
                            Focusable="False"
                            IsTabStop="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- 16:9 缩略图区域 -->
                            <Border Grid.Row="0"
                                    Background="{StaticResource CardBackground}"
                                    CornerRadius="12"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- 默认图标 -->
                                    <TextBlock Text="🎬"
                                               FontSize="72"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentColor}"
                                               Visibility="{Binding ThumbnailPath, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}"/>
                                    <!-- 缩略图 -->
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToImage}}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding ThumbnailPath, Converter={StaticResource NullToVisibility}}"/>
                                    <!-- 时长标签 -->
                                    <Border Background="Black" Opacity="0.7"
                                            Height="35"
                                            VerticalAlignment="Bottom"
                                            CornerRadius="0,0,0,0">
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="White"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="15,5"/>
                                    </Border>
                                </Grid>
                            </Border>
                            
                            <!-- 标题 -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Title}"
                                       Style="{StaticResource MediumTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       Margin="10,10,10,5"
                                       MaxWidth="{Binding DataContext.TitleMaxWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2" Background="{StaticResource SecondaryBackground}" Padding="20">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{StaticResource SmallTextBlockStyle}"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
