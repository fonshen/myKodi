<UserControl x:Class="SimpleVideoPlayer.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="Black"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <Style x:Key="CirclePlaybackButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="112"/>
            <Setter Property="Height" Value="112"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#CC202020"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="56">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#E63A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="VideoGrid"
          SizeChanged="VideoGrid_SizeChanged"
          MouseLeftButtonDown="VideoGrid_MouseLeftButtonDown"
          MouseRightButtonDown="VideoGrid_MouseRightButtonDown">
        <vlc:VideoView x:Name="VideoView"
                       Background="Black"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       IsHitTestVisible="False"/>

        <Popup x:Name="ControlsPopup"
               PlacementTarget="{Binding ElementName=VideoGrid}"
               Placement="Relative"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border x:Name="ControlsPanel"
                    Padding="26,20"
                    Background="#E6000000"
                    CornerRadius="0"
                    IsHitTestVisible="True"
                    MouseLeftButtonDown="ClickCapture_MouseLeftButtonDown"
                    MouseRightButtonDown="ClickCapture_MouseRightButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="PlayPauseButton"
                            Grid.Row="0"
                            Style="{StaticResource CirclePlaybackButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,-8,0,18"
                            Click="PlayPauseButton_Click">
                        <Button.Content>
                            <TextBlock Text="Ⅱ" FontSize="54" Foreground="White"/>
                        </Button.Content>
                    </Button>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding VideoTitle}"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,30,0"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding PositionText}"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <ProgressBar Grid.Row="2"
                                 Value="{Binding Progress}"
                                 Maximum="100"
                                 Height="18"
                                 Background="#404040"
                                 Foreground="{StaticResource AccentColor}"/>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
