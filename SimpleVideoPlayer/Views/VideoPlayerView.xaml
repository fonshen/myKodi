<UserControl x:Class="SimpleVideoPlayer.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:converters="clr-namespace:SimpleVideoPlayer.Converters"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Background="Black"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacity"/>
    </UserControl.Resources>

    <Grid x:Name="VideoGrid"
          SizeChanged="VideoGrid_SizeChanged"
          MouseLeftButtonDown="VideoGrid_MouseLeftButtonDown"
          MouseRightButtonDown="VideoGrid_MouseRightButtonDown">
        <vlc:VideoView x:Name="VideoView"
                       Background="Black"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       IsHitTestVisible="False"/>

        <Popup x:Name="ControlsPopup"
               PlacementTarget="{Binding ElementName=VideoGrid}"
               Placement="Relative"
               AllowsTransparency="True"
               StaysOpen="True"
               Focusable="False"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Grid x:Name="PopupRoot"
                  Width="{Binding ActualWidth, ElementName=VideoGrid}"
                  Height="{Binding ActualHeight, ElementName=VideoGrid}">
                <Grid x:Name="ControlsOverlay"
                      Background="#80000000"
                      Opacity="{Binding ShowControls, Converter={StaticResource BoolToOpacity}}"
                      Panel.ZIndex="100"
                      IsHitTestVisible="{Binding ShowControls}"
                      MouseLeftButtonDown="ClickCapture_MouseLeftButtonDown"
                      MouseRightButtonDown="ClickCapture_MouseRightButtonDown">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#80000000" Padding="30,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="返回"
                                    Style="{StaticResource LargeButtonStyle}"
                                    Command="{Binding StopAndGoBackCommand}"
                                    FontSize="24"
                                    Padding="20,12"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding VideoTitle}"
                                       Style="{StaticResource LargeTextBlockStyle}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="20,0"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <TextBlock Text="{Binding Volume, StringFormat={}{0}%}"
                                           Foreground="White"
                                           FontSize="24"
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0"/>
                                <TextBlock Text="音量"
                                           Foreground="White"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Content="&lt;&lt;"
                                Style="{StaticResource LargeButtonStyle}"
                                FontSize="48"
                                Width="100" Height="100"
                                Click="RewindButton_Click"/>

                        <Button x:Name="PlayPauseButton"
                                Style="{StaticResource LargeButtonStyle}"
                                FontSize="60"
                                Width="150" Height="150"
                                Margin="40,0"
                                Click="PlayPauseButton_Click">
                            <Button.Content>
                                <TextBlock Text="||" FontSize="64"/>
                            </Button.Content>
                        </Button>

                        <Button Content="&gt;&gt;"
                                Style="{StaticResource LargeButtonStyle}"
                                FontSize="48"
                                Width="100" Height="100"
                                Click="FastForwardButton_Click"/>
                    </StackPanel>

                    <Border Grid.Row="2" Background="#80000000" Padding="30,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="{Binding PositionText}"
                                       Foreground="White"
                                       FontSize="28"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,10"/>

                            <ProgressBar Grid.Row="1"
                                         Value="{Binding Progress}"
                                         Maximum="100"
                                         Height="15"
                                         Background="#404040"
                                         Foreground="{StaticResource AccentColor}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border x:Name="ProgressFeedbackOverlay"
                        VerticalAlignment="Bottom"
                        Margin="30,0,30,35"
                        Padding="24,16"
                        Background="#CC000000"
                        CornerRadius="12"
                        Opacity="{Binding ShowProgressBar, Converter={StaticResource BoolToOpacity}}"
                        IsHitTestVisible="False"
                        Panel.ZIndex="101">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding PositionText}"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,12"/>

                        <ProgressBar Grid.Row="1"
                                     Value="{Binding Progress}"
                                     Maximum="100"
                                     Height="18"
                                     Background="#404040"
                                     Foreground="{StaticResource AccentColor}"/>
                    </Grid>
                </Border>

            </Grid>
        </Popup>
    </Grid>
</UserControl>
